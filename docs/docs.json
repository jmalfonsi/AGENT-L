            "pages": [
              "core/kernel",
              "core/durable-execution",
              "core/async"
            ]
          },
          {
            "group": "Vérifier et exploiter",
            "pages": [
              "core/quality-gates",
              "core/verifier",
              "core/boundary",
              "core/record-and-replay",
              "core/benchmarks"
            ]
          }
        ]
      },
      {
        "tab": "Studio",
        "icon": "panels-top-left",
        "groups": [
          {
            "group": "Prise en main",
            "pages": [
              "studio/overview",
              "studio/installation",
              "studio/first-project"
            ]
          },
          {
