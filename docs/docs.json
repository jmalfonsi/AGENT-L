{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "AGENT-L",
  "description": "Documentation officielle du langage agentique vérifiable AGENT-L et de son Studio.",
  "colors": {
    "primary": "#6757E8",
    "light": "#9B8CFF",
    "dark": "#7465E8"
  },
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg",
    "href": "https://github.com/jmalfonsi/AGENT-L"
  },
  "favicon": "/assets/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#FBFAFF",
      "dark": "#0B0A12"
    }
  },
  "styling": {
