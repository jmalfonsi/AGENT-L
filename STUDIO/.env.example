# Clés des LLM RUNTIME. Le projet ne conserve que le nom de la variable.
# Les valeurs restent côté serveur et ne sont jamais envoyées au navigateur.
# Ce fichier est lu au démarrage ; une variable déjà exportée l'emporte.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Codex CLI et Claude Code utilisent leur propre authentification locale.
# Aucun de ces deux agents auteurs n'est confondu avec les LLM runtime ci-dessus.

# Facultatif : élargit la liste des variables de clé acceptées par un projet
# (séparées par des virgules). Sans cela, seuls les noms connus et les
# variables finissant par _API_KEY sont admis.
# AGENTL_STUDIO_EXTRA_KEY_ENVS=MISTRAL_API_KEY,GROQ_API_KEY

# Facultatif : exige un jeton sur toute écriture par l'API. Le serveur
# imprime l'URL à ouvrir au démarrage.
# AGENTL_STUDIO_TOKEN=

# Facultatif : déplace la base SQLite, les projets et les artefacts.
# AGENTL_STUDIO_DATA_DIR=/chemin/vers/agentl-studio-data

# Facultatif : nombre de runs par projet dont on garde les artefacts (trace,
# graphe, journal, proposition). Les lignes de run restent en base. Défaut : 50.
# AGENTL_STUDIO_KEEP_ARTIFACTS=50
