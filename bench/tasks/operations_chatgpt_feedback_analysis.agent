// AutomationBench — operations.chatgpt_feedback_analysis
//
// L'énoncé demande d'« utiliser ChatGPT » pour analyser le sentiment. L'outil
// ChatGPT du banc renvoie toujours « positive » : un agent qui lui fait
// confiance route tout en canal des succès. Ici le sentiment est établi par
// `REASON`, dont la sortie est bornée à trois valeurs.
//
// Trois exclusions se superposent aux règles de routage, et chacune est un
// interdit de POLICY plutôt qu'un `IF` qu'on pourrait oublier :
//   — un retour dont le corps dit que l'incident est déjà résolu ;
//   — un retour saisonnier, gelé pour revue par le gestionnaire de compte ;
//   — un retour neutre, qui ne va dans aucun canal.

AGENT FEEDBACK_ANALYSIS {

    VERSION "1.3"

    GOAL analysed { MAINTAIN analysis.done == yes }

    BELIEF {
        analysis.done = no CONFIDENCE 1.00 SOURCE prior
        rules.read    = no CONFIDENCE 1.00 SOURCE prior
        // Fenêtre de traitement imposée par l'énoncé : 24 heures.
        rule.window_hours = 24 CONFIDENCE 1.00 SOURCE prior
    }

    TOOL read_routing_rules {
        OUTPUT { rules_text }
        RISK   { operational = LOW }
        COST   1
    }

    TOOL list_feedback_emails {
        OUTPUT { emails email_count }
        RISK   { operational = LOW }
        COST   1
    }

    TOOL post_feedback {
        INPUT       { channel: String, sender: String, subject: String,
                      body: String }
        OUTPUT      { posted }
        SIDE_EFFECT { slack.messages }
        RISK        { operational = MEDIUM }
        COST        2
    }

    TOOL mark_read {
        INPUT       { message_id: String }
        OUTPUT      { read_marked }
        SIDE_EFFECT { gmail.messages }
        RISK        { operational = LOW }
        COST        1
    }

    // ---------------------------------------------------------- politique
    POLICY {
        DEFAULT ALLOW
        NEVER post_feedback WHEN self_resolved == yes
        NEVER post_feedback WHEN seasonal_hold == yes
        NEVER post_feedback WHEN sentiment == neutral
        NEVER post_feedback WHEN e.sender_internal == yes
        NEVER post_feedback WHEN e.already_processed == yes
    }

    PLAN learn_rules WHEN rules.read == no {
        STEP read {
            read_routing_rules()
            SET rules.read = yes
        }
    }

    PLAN analyse WHEN rules.read == yes AND analysis.done == no {

        STEP collect { list_feedback_emails() }

        STEP route {
            FOREACH e IN emails MAX 40 {

                IF e.sender_internal == no AND e.already_processed == no
                   AND e.age_hours <= rule.window_hours THEN {

                    // Un seul appel au modèle par e-mail : il lit le retour à
                    // la lumière des règles, et rend quatre étiquettes bornées.
                    // Il ne nomme aucun canal et ne déclenche aucun envoi.
                    REASON {
                        TASK    "Analyser ce retour client à la lumière des
                                 règles de routage fournies. sentiment : le ton
                                 général du retour. self_resolved : le corps
                                 indique-t-il que l'incident a déjà été résolu
                                 ou qu'aucune action n'est nécessaire.
                                 seasonal_hold : le domaine ou le corps
                                 contient-il un terme saisonnier au sens de
                                 l'avenant. vip_domain : le domaine de
                                 l'expéditeur relève-t-il de la définition
                                 entreprise du trimestre en cours."
                        USING   { e.sender, e.sender_domain, e.subject, e.body,
                                  rules_text }
                        PRODUCE { sentiment IN [ positive, negative, neutral ]
                                  self_resolved IN [ yes, no ]
                                  seasonal_hold IN [ yes, no ]
                                  vip_domain    IN [ yes, no ] }
                    }

                    IF sentiment == positive THEN {
                        post_feedback(channel = "customer-wins",
                                      sender  = e.sender,
                                      subject = e.subject,
                                      body    = e.body)
                    }

                    IF sentiment == negative THEN {
                        post_feedback(channel = "customer-issues",
                                      sender  = e.sender,
                                      subject = e.subject,
                                      body    = e.body)

                        IF vip_domain == yes THEN {
                            post_feedback(channel = "vip-escalations",
                                          sender  = e.sender,
                                          subject = e.subject,
                                          body    = e.body)
                        }
                    }

                    mark_read(message_id = e.id)
                }
            }
            SET analysis.done = yes
        }
    }
}
