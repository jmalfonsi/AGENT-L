      workflow.done == yes
    } WITHIN 3
  }

  // Budget : ~3 ticks par consigne (lire, régler, avancer), ~3 par ligne
  // (lire, agir, avancer), plus un tick par nouvelle tentative et par cycle
  // de perception raté. Le plafond vient de LOOP … MAX : la plateforme le
  // lit ici, jamais dans une constante qui tronquerait la file.
  LOOP UNTIL workflow.done == yes MAX 120 {
    OBSERVE
    UPDATE_BELIEFS
    EVALUATE_GOALS
    SELECT_PLAN
    EXECUTE
    VERIFY
  }
}
