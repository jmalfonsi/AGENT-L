  SCENARIO finished_batch_is_reported_then_closed {
    GIVEN {
      source.read_ok = yes
      directive.available = no
      row.available = no
      row.processed = no
      row.routed = no
      row.skipped = no
      policy.adopted = yes
      cursor.advanced = yes
      workflow.blocked = no
      workflow.done = no
      batch.remaining = 0
