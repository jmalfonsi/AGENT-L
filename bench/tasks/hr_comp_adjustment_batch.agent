      close_batch.closed = yes
    }
    EXPECT {
      row.processed != yes
      row.routed != yes
      report.posted != yes
      workflow.blocked == yes
    } WITHIN 2
  }

  // Un cycle de perception raté n'est pas une source en panne : rien ne se
  // clôt, rien ne se publie, rien ne s'écrit.
  SCENARIO unreadable_cycle_does_nothing {
    GIVEN {
      source.read_ok = unknown
      directive.available = unknown
      row.available = unknown
      row.processed = no
      row.routed = no
      row.skipped = no
      policy.adopted = no
      cursor.advanced = no
      workflow.blocked = no
      workflow.done = no
      batch.remaining = 3
      report.posted = no

      policy.limit = 0
      policy.escalation_contact = none
