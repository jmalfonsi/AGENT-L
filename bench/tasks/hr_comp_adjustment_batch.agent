  }

  SCENARIO summary_waits_for_the_whole_batch {
    GIVEN {
      source.read_ok = yes
      directive.available = no
      row.available = no
      policy.adopted = no
      cursor.advanced = no
      workflow.blocked = no
      workflow.done = no
      row.processed = no
