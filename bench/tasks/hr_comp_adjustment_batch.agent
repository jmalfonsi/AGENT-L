      row.over_limit = no
      hold_status = unknown
      verification_status = unknown
    }
    EXPECT { report.posted != yes } WITHIN 3
  }

  LOOP UNTIL workflow.done == yes MAX 60 {
    OBSERVE
    UPDATE_BELIEFS
    EVALUATE_GOALS
    SELECT_PLAN
    EXECUTE
    VERIFY
  }
}
