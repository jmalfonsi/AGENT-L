      row.current_salary = 120000
      row.new_salary = 128000
      row.raise_amount = 8000
      row.stated_raise = 8000
      row.status = Approved
      row.notes = ""
      row.evidence_token = "tok-2"
      policy.adopted = no
      cursor.advanced = no
      workflow.blocked = no
      workflow.done = no
      row.processed = no
      row.routed = no
      batch.acted = no
      batch.remaining = 1
      report.posted = no

      policy.limit = 0
      policy.escalation_contact = "cfo@company.example.com"
      row.analyzed = yes
      row.eligible = yes
      row.over_limit = no
      hold_status = clear
      verification_status = clear
    }
    EXPECT {
      row.processed != yes
      row.routed != yes
    } WITHIN 4
  }

  SCENARIO no_adopted_limit_blocks_escalation_too {
    GIVEN {
      source.read_ok = yes
      directive.available = no
