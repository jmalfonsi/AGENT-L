  }

  // Une ligne réglée par une réponse perdue APRÈS l'effet : le registre la
  // montre traitée alors que l'automate n'a rien reçu. On avance sans
  // rejouer — ni traitement, ni escalade, ni écart.
  SCENARIO settled_row_is_advanced_without_replaying_the_effect {
    GIVEN {
      source.read_ok = yes
      directive.available = no
      row.available = yes
      row.row_id = 5
      row.employee = "Tobi Adeyemi"
      row.employee_email = "tobi.adeyemi@company.example.com"
      row.employee_domain = "company.example.com"
      row.manager_email = "mgr-eng@company.example.com"
      row.manager_domain = "company.example.com"
      row.current_salary = 135000
      row.new_salary = 147000
      row.raise_amount = 12000
      row.stated_raise = 12000
      row.status = Approved
      row.notes = ""
      row.evidence_token = "tok-5"
      row.processed = yes
      row.routed = no
      row.skipped = no
      policy.adopted = yes
      cursor.advanced = no
      workflow.blocked = no
      workflow.done = no
      batch.remaining = 3
      report.posted = no

      policy.limit = 15000
      policy.escalation_contact = "cfo@company.example.com"
      row.analyzed = yes
      row.decision = process
      hold_status = clear
      verification_status = clear
      mentions_reversal = no
    }
    // Réponses du monde simulé : tout outil que ce monde — ou un monde
    // dérivé par `autoloop` — peut appeler répond.
    GIVEN {
      adopt_directive.adopted = yes
      advance_directive.advanced = yes
      process_adjustment.processed = yes
      process_adjustment.employee_notified = yes
      process_adjustment.manager_notified = yes
      process_adjustment.tracker_updated = yes
      route_to_cfo.routed = yes
      skip_adjustment.skipped = yes
      advance_row.advanced = yes
      post_summary.posted = yes
      mark_blocked.marked = yes
      close_batch.closed = yes
    }
    EXPECT {
      cursor.advanced == yes
      row.skipped != yes
      row.routed != yes
    } WITHIN 2
  }

  SCENARIO source_failure_writes_nothing_and_publishes_nothing {
    GIVEN {
