      row.routed = no
      batch.acted = no
      batch.remaining = 0
      report.posted = no

      policy.limit = 0
      policy.escalation_contact = none
      directive.analyzed = yes
      is_procedure = yes
      authority_limit = 15000
    }
    EXPECT { policy.adopted == yes } WITHIN 3
  }

  // Mordant : retirer `NEVER process_adjustment WHEN policy.limit <= 0` fait
  // tomber ce scénario — indéterminé n'est pas zéro.
  SCENARIO no_adopted_limit_blocks_every_write {
    GIVEN {
      source.read_ok = yes
      directive.available = no
      row.available = yes
